# MongoDB connection string
# Local example: mongodb://127.0.0.1:27017/holdings-break-checker
# Atlas example: mongodb+srv://<user>:<password>@cluster0.mongodb.net/holdings-break-checker
MONGO_URI=mongodb://127.0.0.1:27017/holdings-break-checker

# Port the Express API listens on
PORT=5000

# Origin allowed to call this API (the Vite dev server)
CLIENT_ORIGIN=http://localhost:5173
